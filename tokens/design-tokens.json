{
  "name": "LAPIS Design System 2.5D & 3D",
  "version": "1.0",
  "color": {
    "electric-blue": "#0D6EFD",
    "silver": "#C0C4CC",
    "deep-black": "#0B0B0D",
    "dark-navy": "#080E1B",
    "panel-deep": "#18243A",
    "light-silver": "#E2E7F0",
    "white": "#FFFFFF",
    "cyan-glow": "#00CFFF"
  },
  "distribution": { "black-navy": "50%", "silver": "25%", "blue": "15%", "white-cyan": "10%" },
  "font": {
    "heading": "Space Grotesk",
    "body": "Inter",
    "weight": { "heading": [500, 600, 700], "body": [400, 500, 600] }
  },
  "depth": {
    "L0-background": { "shadow": "none", "parallax": 0.2 },
    "L1-surface": { "shadow": "0 10px 24px rgba(0,0,0,0.25)", "parallax": 0.5 },
    "L2-raised": { "shadow": "0 18px 36px rgba(0,0,0,0.30)", "parallax": 0.8 },
    "L3-floating": { "shadow": "0 28px 54px rgba(0,0,0,0.35)", "parallax": 1.0 }
  },
  "light": { "direction": "top-left", "facet": { "top": "lightest", "left": "mid", "right": "darkest" } },
  "radius": { "sm": "10px", "md": "18px", "lg": "28px", "pill": "999px" },
  "spacing": { "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "xxl": "48px", "xxxl": "64px" },
  "motion": {
    "duration": { "micro": "150-250ms", "ui": "300-500ms", "panel-reveal": "500-800ms", "scene": "600-1000ms" },
    "spring": "low damping, soft overshoot",
    "float": { "amplitude": "4-8px", "cycle": "3-5s" },
    "forbidden": ["linear easing", "plain fade without movement"]
  }
}
